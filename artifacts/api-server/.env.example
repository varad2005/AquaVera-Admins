# ============================================================
# AquaVera API Server Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# NEVER put real credentials here.
# ============================================================

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# JWT Secret — use a long random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=replace-with-a-long-random-secret-in-production

# Supabase project URL (from Supabase dashboard > Settings > API)
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co

# Supabase Service Role key — NEVER expose this to the frontend
# (from Supabase dashboard > Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage bucket name for evidence images
SUPABASE_STORAGE_BUCKET=evidence-images

# CORS allowed origin (for production deployments)
CORS_ORIGIN=https://your-production-domain.com

# Port (optional, defaults to 3000)
PORT=3000

# Log level (optional, defaults to info)
LOG_LEVEL=info

# Node environment
NODE_ENV=development
